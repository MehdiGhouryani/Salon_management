# =============================================================================
# NobatAra — PRODUCTION Environment Checklist (TEMPLATE — no real secrets)
# =============================================================================
# This file documents what a production deployment MUST provide through the
# platform's environment (Cloud Run / container orchestrator secret manager).
# It is a checklist, not a file to deploy. Never commit real values.
# `.env` files are NOT loaded when NODE_ENV=production (server/config.ts:4).

# --- Mandatory (server refuses to start without these) ----------------------
# Runtime environment
NODE_ENV=production

# PostgreSQL. NobatAra refuses to start in production without it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nobatara?sslmode=require

# Session signing secret: generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<GENERATED_64+_CHAR_RANDOM_SECRET>

# --- Mandatory review (empty is only valid for same-origin serving) ---------
# Cross-origin API consumers, e.g. https://app.example.com
CORS_ORIGIN=

# Reverse-proxy hops in front of the app. MUST be set explicitly behind a TLS-
# terminating proxy (e.g. TRUST_PROXY_COUNT=1) so req.ip reflects real client
# IPs for rate limiting and audit logs. Default 0 trusts nothing (direct
# exposure only). Values 0-5; anything else refuses to start (server/config.ts).
TRUST_PROXY_COUNT=1

# --- Strongly recommended ---------------------------------------------------
# Real SMS provider. Without a key, OTP delivery fails closed with 503 and
# the readiness warning names the missing capability (never a mock).
# Setup steps (docs/SETUP.md §SMS):
#   1. Kavenegar dashboard → create an approved verify/lookup template
#      named exactly SMS_TEMPLATE below (default: nobatara-otp)
#   2. Copy the API key into KAVENEGAR_API_KEY (platform secret manager —
#      never committed)
#   3. SMS_PROVIDER=kavenegar (or `null` to explicitly disable SMS)
#   4. Restart and confirm /api/health/ready no longer warns about SMS
SMS_PROVIDER=kavenegar
SMS_TEMPLATE=nobatara-otp
SMS_TIMEOUT_MS=10000
SMS_MAX_ATTEMPTS=2
KAVENEGAR_API_KEY=<PROVIDER_KEY>

# --- Optional tuning (defaults shown) ---------------------------------------
# APP_MODE=production
# PORT=8080
# HOST=0.0.0.0
# BODY_LIMIT=1mb
# SESSION_COOKIE_NAME=nobatara_session
# SESSION_TTL_HOURS=336
# SESSION_IDLE_MINUTES=120
# OTP_TTL_SECONDS=120
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=3
# DB_POOL_MIN=2
# DB_POOL_MAX=10
