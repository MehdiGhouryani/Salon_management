# Server & Environment
NODE_ENV=development
APP_MODE=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=
BODY_LIMIT=1mb

# Database Configuration (PostgreSQL / Cloud SQL)
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=nobatara
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Authentication & Sessions
SESSION_SECRET=dev-insecure-nobatara-session-secret-change-in-production
SESSION_COOKIE_NAME=nobatara_session
SESSION_TTL_HOURS=336
SESSION_IDLE_MINUTES=120
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# SMS Gateway (Kavenegar)
KAVENEGAR_API_KEY=

# Gemini API
GEMINI_API_KEY=