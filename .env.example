# ==============================================================================
# NobatAra Server & Runtime Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# CRITICAL SECURITY RULES:
# 1. NEVER commit real passwords, API secrets, private keys, or credentials to git.
# 2. Server-side secrets must NEVER be prefixed with VITE_* (which exposes them to client bundles).
# 3. Production deployments inject environment variables directly via Cloud Run / container environment.
# ==============================================================================

# Node Environment
# Allowed values: 'development' | 'production' | 'test'
NODE_ENV=development

# Application Execution Mode
# Allowed values: 'development' | 'production' | 'test'
# In production, this enforces strict server-side authentication posture and disables mock fixtures.
APP_MODE=development

# HTTP Server Network Binding
# Port 3000 is required by the AI Studio preview runtime. Cloud Run uses $PORT (defaults to 8080 or 3000).
PORT=3000
HOST=0.0.0.0

# CORS Configuration
# Optional comma-separated list of allowed origins. In production, defaults to same-origin.
# Example: https://nobatara.ir,https://admin.nobatara.ir
CORS_ORIGIN=

# Request Limits
# Maximum request body size for JSON payloads.
BODY_LIMIT=1mb

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Phase 4 Foundation)
# ------------------------------------------------------------------------------
# You can provide a unified DATABASE_URL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nobatara?sslmode=disable
#
# Or individual connection parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nobatara
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false
#
# Connection Pool Tuning:
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Future Integration Placeholders (Scheduled for Phase 5 and 10)
# ------------------------------------------------------------------------------
# SESSION_SECRET=
# KAVENEGAR_API_KEY=
# ZARINPAL_MERCHANT_ID=

