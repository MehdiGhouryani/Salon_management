# =============================================================================
# NobatAra — Development Environment Template
# =============================================================================
# Copy this file to `.env` for local development:  cp .env.example .env
# NEVER put real credentials in this file. Real secrets live only in:
#   - your local .env (never committed)
#   - the production platform's secret manager (see .env.production.example)
#
# `.env` is loaded ONLY when NODE_ENV is not "production" (server/config.ts:4).
# In production the process environment must be provided by the platform.

# -----------------------------------------------------------------------------
# Server & Runtime
# -----------------------------------------------------------------------------
# NODE_ENV: development | production | test   (server/config.ts:53)
NODE_ENV=development
# APP_MODE: development | production | test   (defaults to NODE_ENV if unset).
# "production" app mode enforces production posture (no demo, fail-closed).
APP_MODE=development
PORT=3000
HOST=0.0.0.0
# Comma-separated allowlist of cross-origin frontends (CORS + CSRF origin check).
# Empty is correct when the API and frontend are served from the same origin.
CORS_ORIGIN=
# Express JSON body size limit (e.g. 1mb, 512kb)
BODY_LIMIT=1mb

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — REQUIRED in production, optional in development
# -----------------------------------------------------------------------------
# Preferred form:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Or the discrete variables below (used when DATABASE_URL is empty).
# IMPORTANT: in development with NO database configured, the server runs on
# in-memory dev stores (non-persistent, dev-only). Production refuses to start
# without a configured database (server/config.ts).
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=nobatara
DB_USER=postgres
DB_PASSWORD=
# DB_SSL=true forces TLS (implied by sslmode=require inside DATABASE_URL)
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Authentication & Sessions
# -----------------------------------------------------------------------------
# MUST be >= 32 chars in production. The value below is a dev-only placeholder.
SESSION_SECRET=dev-insecure-nobatara-session-secret-change-in-production
SESSION_COOKIE_NAME=nobatara_session
# Absolute session lifetime in hours (336 = 14 days)
SESSION_TTL_HOURS=336
# Idle timeout in minutes
SESSION_IDLE_MINUTES=120
# OTP challenge policy
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# SMS Gateway (Kavenegar) — REQUIRED for real OTP delivery in production
# -----------------------------------------------------------------------------
# SMS_PROVIDER: kavenegar (real gateway) | null (explicitly disabled —
# requests fail closed with a clear "SMS disabled" error; never a silent mock)
SMS_PROVIDER=kavenegar
# Kavenegar verify/lookup template name approved in the Kavenegar dashboard
SMS_TEMPLATE=nobatara-otp
# Per-attempt gateway timeout (ms) and bounded retry attempts (transport
# failures only — business rejections like no-credit are never retried)
SMS_TIMEOUT_MS=10000
SMS_MAX_ATTEMPTS=2
# In development without a key, the isolated DevMockSmsProvider is used and
# codes are never really sent. In production, SMS failure fails closed (503).
KAVENEGAR_API_KEY=

# -----------------------------------------------------------------------------
# Frontend build-time flags (Vite `import.meta.env`, non-secret)
# -----------------------------------------------------------------------------
# DISABLE_HMR=true disables Vite HMR/watching (used inside AI Studio previews)
DISABLE_HMR=
# Optional frontend posture overrides (src/utils/env.ts). Never store secrets
# here — Vite env vars are embedded into the public client bundle.
#   VITE_APP_MODE=development|production|test
#   VITE_DEMO_MODE=true|false
